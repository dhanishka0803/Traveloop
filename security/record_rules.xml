<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Trips: each user sees only their own ── -->
    <record id="rule_trip_own" model="ir.rule">
        <field name="name">Trip: own records only</field>
        <field name="model_id" ref="model_traveloop_trip"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admin sees all trips -->
    <record id="rule_trip_admin" model="ir.rule">
        <field name="name">Trip: admin sees all</field>
        <field name="model_id" ref="model_traveloop_trip"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- ── Stops: via trip ownership ── -->
    <record id="rule_stop_own" model="ir.rule">
        <field name="name">Stop: own trips only</field>
        <field name="model_id" ref="model_traveloop_stop"/>
        <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Trip Activities: via stop → trip ── -->
    <record id="rule_trip_activity_own" model="ir.rule">
        <field name="name">Trip Activity: own trips only</field>
        <field name="model_id" ref="model_traveloop_trip_activity"/>
        <field name="domain_force">[('stop_id.trip_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Expenses: via trip ownership ── -->
    <record id="rule_expense_own" model="ir.rule">
        <field name="name">Expense: own trips only</field>
        <field name="model_id" ref="model_traveloop_expense"/>
        <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Checklist: via trip ownership ── -->
    <record id="rule_checklist_own" model="ir.rule">
        <field name="name">Checklist: own trips only</field>
        <field name="model_id" ref="model_traveloop_checklist_item"/>
        <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Notes: via trip ownership ── -->
    <record id="rule_note_own" model="ir.rule">
        <field name="name">Note: own trips only</field>
        <field name="model_id" ref="model_traveloop_note"/>
        <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
